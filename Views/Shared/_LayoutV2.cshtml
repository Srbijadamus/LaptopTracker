@using Microsoft.AspNetCore.Mvc.Localization
@using LaptopTracker.Services
@inject IViewLocalizer Localizer
@inject ICurrentUser CurrentUser
@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var kid  = CurrentUser.Kid ?? "ANONYMOUS";
    var initials = kid.Length >= 2 ? kid[..2] : kid;
    var curCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var curCountry = Context.Session.GetString("CountryFilter") ?? "";
    var countryCodes = LaptopTracker.Helpers.LocationList.LocationCountry.Values.Distinct().OrderBy(c => c).ToList();
}
<!DOCTYPE html>
<html lang="@curCulture">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@(ViewData["Title"] != null ? ViewData["Title"] + " | " : "")WIC Asset Tracker</title>
<link rel="stylesheet" href="/css/theme.css" />
@RenderSection("Styles", required: false)
<script>(function(){var t=localStorage.getItem('theme')||'dark';document.documentElement.setAttribute('data-theme',t);})();</script>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter',-apple-system,"Segoe UI",Roboto,sans-serif;background:var(--bg-app);color:var(--text-primary)}

/* ── Sidebar ───────────────────────────────────────────────────── */
.v2-sidebar{
  position:fixed;top:0;left:0;bottom:0;width:280px;width:var(--sidebar-w,280px);
  background:var(--bg-sidebar);border-right:1px solid var(--v2-border);
  display:flex;flex-direction:column;z-index:200;transition:width .2s ease,transform .2s ease;
  overflow:hidden;
}

/* Brand */
.v2-brand{
  display:flex;align-items:center;gap:14px;padding:22px 20px 20px;
  border-bottom:1px solid var(--v2-border);flex-shrink:0;
}
.v2-brand-icon{
  width:38px;height:38px;border-radius:10px;background:var(--accent-soft);
  display:flex;align-items:center;justify-content:center;flex-shrink:0;
}
.v2-brand-icon svg{width:20px;height:20px;fill:var(--v2-accent)}
.v2-brand-text{min-width:0}
.v2-brand-name{font-size:15px;font-weight:700;color:var(--text-primary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.v2-brand-sub{font-size:11px;color:var(--text-muted);white-space:nowrap}

/* Nav */
.v2-nav{flex:1;padding:16px 12px 8px;overflow-y:auto;overflow-x:hidden}
.v2-nav-label{font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--text-muted);padding:0 8px;margin-bottom:6px;white-space:nowrap;overflow:hidden}
.v2-nav-item{
  display:flex;align-items:center;gap:11px;padding:9px 10px;border-radius:var(--radius-tile);
  text-decoration:none;color:var(--text-secondary);font-size:14px;font-weight:500;
  position:relative;white-space:nowrap;overflow:hidden;margin-bottom:2px;
  transition:background .12s,color .12s;
}
.v2-nav-item:hover{background:var(--bg-hover);color:var(--text-primary)}
.v2-nav-item.active{background:var(--accent-soft);color:var(--v2-accent);font-weight:600}
.v2-nav-item.active::before{
  content:'';position:absolute;left:0;top:20%;bottom:20%;width:3px;
  background:var(--v2-accent);border-radius:0 3px 3px 0;
}
.v2-nav-icon{width:18px;height:18px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:16px}
.v2-nav-text{overflow:hidden;text-overflow:ellipsis}

/* Divider */
.v2-nav-divider{height:1px;background:var(--v2-border);margin:10px 8px}

/* Localization / toggles strip */
.v2-nav-strip{
  display:flex;align-items:center;gap:4px;padding:8px 12px 4px;flex-wrap:wrap;
}
.v2-strip-btn{
  padding:5px 10px;border-radius:6px;font-size:12px;font-weight:500;
  color:var(--text-secondary);text-decoration:none;background:transparent;
  border:1px solid transparent;transition:background .1s,border-color .1s;white-space:nowrap;
}
.v2-strip-btn:hover{background:var(--bg-hover);border-color:var(--v2-border)}
.v2-strip-select{
  flex:1;min-width:80px;padding:5px 8px;border-radius:6px;font-size:12px;
  background:var(--bg-input);color:var(--text-primary);border:1px solid var(--border-input);cursor:pointer;
}

/* User block */
.v2-user{
  display:flex;align-items:center;gap:12px;padding:16px 20px;
  border-top:1px solid var(--v2-border);flex-shrink:0;overflow:hidden;
}
.v2-avatar{
  width:36px;height:36px;border-radius:var(--radius-pill);
  background:var(--accent-soft);color:var(--v2-accent);
  font-size:13px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;
}
.v2-user-info{min-width:0}
.v2-user-kid{font-size:13px;font-weight:600;color:var(--text-primary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.v2-user-sub{font-size:11px;color:var(--text-muted)}

/* Theme toggle in sidebar footer */
.v2-theme-btn{
  margin-left:auto;flex-shrink:0;background:transparent;border:1px solid var(--border-input);
  border-radius:8px;cursor:pointer;font-size:16px;width:34px;height:34px;
  display:flex;align-items:center;justify-content:center;color:var(--text-secondary);
}
.v2-theme-btn:hover{background:var(--bg-hover);border-color:var(--v2-accent)}

/* ── Main content ───────────────────────────────────────────────── */
.v2-main{margin-left:280px;margin-left:var(--sidebar-w,280px);min-height:100vh;padding:32px;transition:margin-left .2s ease}

/* ── Hamburger (hidden above 768px) ─────────────────────────────── */
.v2-hamburger{
  display:none;position:fixed;top:14px;left:14px;z-index:300;
  background:var(--bg-sidebar);border:1px solid var(--v2-border);
  border-radius:8px;width:40px;height:40px;cursor:pointer;
  align-items:center;justify-content:center;font-size:20px;color:var(--text-primary);
}
.v2-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:150}

/* ── Responsive: 768px–1099px — icon-only sidebar ───────────────── */
@@media(max-width:1099px) and (min-width:769px){
  .v2-sidebar{width:60px}
  .v2-brand-text,.v2-nav-text,.v2-nav-label,.v2-nav-divider,
  .v2-user-info,.v2-nav-strip,.v2-brand-sub{display:none}
  .v2-brand{justify-content:center;padding:16px 0}
  .v2-nav-item{justify-content:center;padding:10px 0}
  .v2-user{justify-content:center;padding:12px 0}
  .v2-theme-btn{margin:0}
  .v2-main{margin-left:60px}
}

/* ── Responsive: ≤768px — slide-over ───────────────────────────── */
@@media(max-width:768px){
  .v2-sidebar{transform:translateX(-100%);width:280px;width:var(--sidebar-w,280px)}
  .v2-sidebar.open{transform:translateX(0)}
  .v2-hamburger{display:flex}
  .v2-overlay.open{display:block}
  .v2-main{margin-left:0;padding:20px 16px 16px;padding-top:64px}
}
</style>
</head>
<body>

<button class="v2-hamburger" id="v2Ham" aria-label="@Localizer["NavOpen"]">&#9776;</button>
<div class="v2-overlay" id="v2Overlay"></div>

<aside class="v2-sidebar" id="v2Sidebar">
  <!-- Brand -->
  <div class="v2-brand">
    <div class="v2-brand-icon">
      <svg viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><rect x="1" y="4" width="18" height="12" rx="2"/><rect x="6" y="14" width="8" height="2" rx="1" opacity=".5"/><rect x="7" y="7" width="6" height="4" rx="1" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
    </div>
    <div class="v2-brand-text">
      <div class="v2-brand-name">LaptopTracker</div>
      <div class="v2-brand-sub">@curCulture</div>
    </div>
  </div>

  <!-- Navigation -->
  <nav class="v2-nav">
    <div class="v2-nav-label">Navigation</div>

    <a href="/Dashboard"      class="v2-nav-item@(ctrl=="Dashboard"      ? " active" : "")">
      <span class="v2-nav-icon">&#x1F4CA;</span><span class="v2-nav-text">Dashboard</span>
    </a>
    <a href="/Search"         class="v2-nav-item@(ctrl=="Search"         ? " active" : "")">
      <span class="v2-nav-icon">&#x1F50D;</span><span class="v2-nav-text">@Localizer["NavSearch"]</span>
    </a>

    <div class="v2-nav-divider"></div>
    <div class="v2-nav-label">@Localizer["NavSectionDevices"]</div>

    <a href="/ReturnDevices"  class="v2-nav-item@(ctrl=="ReturnDevices"  ? " active" : "")">
      <span class="v2-nav-icon">&#x1F4E6;</span><span class="v2-nav-text">@Localizer["NavReturns"]</span>
    </a>
    <a href="/WicStock"       class="v2-nav-item@(ctrl=="WicStock"       ? " active" : "")">
      <span class="v2-nav-icon">&#x1F5C4;&#xFE0F;</span><span class="v2-nav-text">@Localizer["NavWicStock"]</span>
    </a>
    <a href="/LoanerDevices"  class="v2-nav-item@(ctrl=="LoanerDevices"  ? " active" : "")">
      <span class="v2-nav-icon">&#x1F4BB;</span><span class="v2-nav-text">@Localizer["NavLoaners"]</span>
    </a>
    <a href="/IdealStock"     class="v2-nav-item@(ctrl=="IdealStock"     ? " active" : "")">
      <span class="v2-nav-icon">&#x1F4CA;</span><span class="v2-nav-text">@Localizer["NavIdealStock"]</span>
    </a>

    <div class="v2-nav-divider"></div>
    <div class="v2-nav-label">@Localizer["NavSectionOps"]</div>

    <a href="/Operations"     class="v2-nav-item@(ctrl=="Operations"     ? " active" : "")">
      <span class="v2-nav-icon">&#x2699;&#xFE0F;</span><span class="v2-nav-text">Operations</span>
    </a>
    <a href="/Handovers"      class="v2-nav-item@(ctrl=="Handovers"      ? " active" : "")">
      <span class="v2-nav-icon">&#x1F91D;</span><span class="v2-nav-text">@Localizer["NavHandovers"]</span>
    </a>
    <a href="/Archive"        class="v2-nav-item@(ctrl=="Archive"        ? " active" : "")">
      <span class="v2-nav-icon">&#x1F5C2;&#xFE0F;</span><span class="v2-nav-text">@Localizer["NavArchive"]</span>
    </a>
    <a href="/Audit"          class="v2-nav-item@(ctrl=="Audit"          ? " active" : "")">
      <span class="v2-nav-icon">&#x1F4CB;</span><span class="v2-nav-text">@Localizer["NavAudit"]</span>
    </a>
  </nav>

  <!-- Controls strip: language + country filter -->
  <div class="v2-nav-strip">
    <a href="@Url.Action("SetLanguage","Localization", new{culture="en-US",returnUrl=Context.Request.Path+Context.Request.QueryString})"
       class="v2-strip-btn" aria-label="English">&#127468;&#127463;</a>
    <a href="@Url.Action("SetLanguage","Localization", new{culture="de-DE",returnUrl=Context.Request.Path+Context.Request.QueryString})"
       class="v2-strip-btn" aria-label="Deutsch">&#127465;&#127466;</a>
    <select class="v2-strip-select"
            onchange="if(this.value!==undefined){window.location.href='/Country/Set?code='+encodeURIComponent(this.value)+'&returnUrl='+encodeURIComponent(window.location.pathname);}">
      @if(curCountry==""){<option value="" selected>&#x1F30D; @Localizer["CountryAll"]</option>}
      @if(curCountry!=""){<option value="">&#x1F30D; @Localizer["CountryAll"]</option>}
      @foreach(var c in countryCodes){
        @if(curCountry==c){<option value="@c" selected>@c</option>}
        @if(curCountry!=c){<option value="@c">@c</option>}
      }
    </select>
  </div>

  <!-- User block -->
  <div class="v2-user">
    <div class="v2-avatar">@initials</div>
    <div class="v2-user-info">
      <div class="v2-user-kid">@kid</div>
      <a href="/Identity/Login" style="font-size:11px;color:var(--v2-accent);text-decoration:none">@Localizer["UserSwitch"]</a>
    </div>
    <button class="v2-theme-btn" id="v2ThemeToggle" onclick="toggleTheme()" title="@Localizer["ThemeToggle"]">&#9728;&#65039;</button>
  </div>
</aside>

<main class="v2-main">
  <div style="font-size:11px;color:var(--text-muted);text-align:right;margin-bottom:16px;padding-bottom:8px;border-bottom:1px solid var(--v2-border)">Developed by Nebojsa Stojnic &mdash; with the selfless support of Ion Ciuceanu.</div>
  @RenderBody()
</main>

<script src="/js/theme.js"></script>
<script src="/js/topscroll.js"></script>
<script>
(function(){
  var ham=document.getElementById('v2Ham'),
      sb =document.getElementById('v2Sidebar'),
      ov =document.getElementById('v2Overlay');
  function open(){sb.classList.add('open');ov.classList.add('open');}
  function close(){sb.classList.remove('open');ov.classList.remove('open');}
  if(ham){ham.addEventListener('click',open);}
  if(ov){ov.addEventListener('click',close);}

  // sync v2 theme button icon
  function syncV2Icon(){
    var t=document.documentElement.getAttribute('data-theme');
    var btn=document.getElementById('v2ThemeToggle');
    if(btn) btn.textContent=t==='dark'?'☀️':'🌙';
  }
  document.addEventListener('DOMContentLoaded',syncV2Icon);
  // patch toggleTheme to also sync v2 icon
  var _orig=window.toggleTheme;
  window.toggleTheme=function(){if(_orig)_orig();syncV2Icon();};
})();
</script>
@RenderSection("Scripts", required: false)
</body>
</html>
