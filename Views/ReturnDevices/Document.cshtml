@model LaptopTracker.Models.ReturnDevice
@using LaptopTracker.Helpers
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = $"{Localizer["PageTitlePrefix"].Value} {Model.SerialNumber}";
    var hasSig = Model.Photos?.Any(p => p.IsSignature) == true;
    var sig    = Model.Photos?.FirstOrDefault(p => p.IsSignature);
}
@section Styles {
<style>
.content{padding:24px 28px 0}
.page-title{font-size:20px;font-weight:700;margin-bottom:6px;color:var(--text-primary)}
.sub{font-size:13px;color:var(--text-muted);margin-bottom:20px}
.doc-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;max-width:900px}
.doc-card{background:var(--bg-panel);border-radius:14px;border:1px solid var(--border);padding:24px 28px}
.doc-card h3{font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--text-secondary);margin-bottom:14px}
.doc-row{display:flex;gap:8px;margin-bottom:8px;font-size:14px}
.doc-label{font-weight:600;color:var(--text-secondary);min-width:140px;flex-shrink:0}
.doc-val{color:var(--text-primary)}
.action-bar{display:flex;gap:12px;align-items:center;flex-wrap:wrap;max-width:900px;margin:20px 0}
.btn-primary{padding:11px 22px;background:var(--accent);color:#fff;border:none;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;text-decoration:none;display:inline-block}
.btn-outline{padding:11px 22px;background:transparent;color:var(--text-secondary);border:1px solid var(--border-input);border-radius:10px;font-size:14px;font-weight:600;cursor:pointer;text-decoration:none;display:inline-block}
.sig-section{max-width:900px;background:var(--bg-panel);border-radius:14px;border:1px solid var(--border);padding:24px 28px;margin-top:20px}
.sig-section h3{font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--text-secondary);margin-bottom:14px}
.sig-existing img{max-height:120px;border:1px solid var(--border);border-radius:8px;background:#fff;padding:4px}
.sig-existing p{font-size:12px;color:var(--text-muted);margin-top:6px}
canvas#sigPad{display:block;width:100%;height:160px;border:2px dashed var(--border-input);border-radius:8px;background:#fff;touch-action:none;cursor:crosshair}
</style>
}
<div class="content">
  <div class="page-title">@Localizer["PageHeading"]</div>
  <div class="sub">@Model.SerialNumber – @Localizer["PageSub"]</div>

  <div class="doc-grid">
    <div class="doc-card">
      <h3>@Localizer["SectionEmployee"]</h3>
      <div class="doc-row"><span class="doc-label">KID</span><span class="doc-val">@(Model.KID ?? "–")</span></div>
      <div class="doc-row"><span class="doc-label">@Localizer["LabelDate"]</span><span class="doc-val">@Model.Date.ToString("dd.MM.yyyy")</span></div>
      <div class="doc-row"><span class="doc-label">@Localizer["LabelLocation"]</span><span class="doc-val">@(Model.Location ?? "–")</span></div>
    </div>
    <div class="doc-card">
      <h3>@Localizer["SectionDevice"]</h3>
      <div class="doc-row"><span class="doc-label">@Localizer["LabelSerial"]</span><span class="doc-val">@Model.SerialNumber</span></div>
      <div class="doc-row"><span class="doc-label">@Localizer["LabelDeviceType"]</span><span class="doc-val">@Model.DeviceType</span></div>
      <div class="doc-row"><span class="doc-label">RITM</span><span class="doc-val">@Model.RITM</span></div>
      @if (!string.IsNullOrWhiteSpace(Model.WorkOrder)) {
        <div class="doc-row"><span class="doc-label">Work Order</span><span class="doc-val">@Model.WorkOrder</span></div>
      }
    </div>
    @if (Model.ChargerReturned.HasValue || Model.PowerCableReturned.HasValue) {
      <div class="doc-card">
        <h3>@Localizer["SectionAccessories"]</h3>
        @if (Model.ChargerReturned.HasValue) {
          <div class="doc-row"><span class="doc-label">@Localizer["LabelCharger"]</span><span class="doc-val">@StatusLocalizer.GetBoolBadge(Model.ChargerReturned, StatusLoc)</span></div>
        }
        @if (Model.PowerCableReturned.HasValue) {
          <div class="doc-row"><span class="doc-label">@Localizer["LabelPowerCable"]</span><span class="doc-val">@StatusLocalizer.GetBoolBadge(Model.PowerCableReturned, StatusLoc)</span></div>
        }
      </div>
    }
  </div>

  <div class="action-bar">
    <a href="/ReturnDevices/DocumentPdf/@Model.Id" class="btn-primary" target="_blank">@Localizer["BtnDownloadPdf"]</a>
    <a href="/ReturnDevices/EmailDraft/@Model.Id" class="btn-outline">@Localizer["BtnEmailDraft"]</a>
    <a href="/ReturnDevices/Edit/@Model.Id" class="btn-outline">@Localizer["BtnBack"]</a>
  </div>

  <!-- Signature section -->
  <div class="sig-section">
    <h3>@Localizer["SectionSignature"]</h3>
    @if (hasSig && sig is not null) {
      <div class="sig-existing">
        <img src="@sig.FilePath" alt="@Localizer["AltSignature"]" />
        <p>@Localizer["LabelCapturedAt"] @sig.UploadedAt.ToString("dd.MM.yyyy HH:mm")</p>
      </div>
      <p style="font-size:13px;color:var(--text-muted);margin-top:12px">@Localizer["SigAlreadyPresent"]</p>
    } else {
      <p style="font-size:13px;color:var(--text-muted);margin-bottom:12px">@Localizer["SigNotYet"]</p>
      <form method="post" action="/ReturnDevices/CaptureSignature/@Model.Id" id="sigForm">
        <div style="position:relative;max-width:600px">
          <canvas id="sigPad"></canvas>
          <button type="button" id="sigClear"
            style="position:absolute;top:8px;right:8px;padding:5px 12px;background:var(--bg-panel);border:1px solid var(--border-input);border-radius:6px;font-size:12px;font-weight:600;color:var(--text-secondary);cursor:pointer">
            @Localizer["BtnClear"]
          </button>
        </div>
        <input type="hidden" name="signatureData" id="sigData" />
        <div style="display:flex;gap:10px;margin-top:12px">
          <button type="submit" class="btn-primary" style="font-size:13px;padding:9px 18px">
            @Localizer["BtnSaveSignature"]
          </button>
        </div>
      </form>
    }
  </div>
</div>
<script>
(function() {
  var canvas = document.getElementById('sigPad');
  if (!canvas) return;
  var ctx = canvas.getContext('2d');
  var drawing = false, hasDrawn = false;

  function resize() {
    var r = canvas.getBoundingClientRect(), dpr = window.devicePixelRatio || 1;
    canvas.width  = Math.round(r.width  * dpr);
    canvas.height = Math.round(r.height * dpr);
    ctx.scale(dpr, dpr);
    ctx.strokeStyle = '#000'; ctx.lineWidth = 2;
    ctx.lineCap = 'round'; ctx.lineJoin = 'round';
  }
  resize();
  window.addEventListener('resize', resize);

  function pos(e) {
    var r = canvas.getBoundingClientRect();
    if (e.touches) return { x: e.touches[0].clientX - r.left, y: e.touches[0].clientY - r.top };
    return { x: e.clientX - r.left, y: e.clientY - r.top };
  }
  canvas.addEventListener('pointerdown', function(e) {
    e.preventDefault(); drawing = true; var p = pos(e);
    ctx.beginPath(); ctx.moveTo(p.x, p.y);
    canvas.setPointerCapture(e.pointerId);
  });
  canvas.addEventListener('pointermove', function(e) {
    if (!drawing) return; e.preventDefault(); var p = pos(e);
    ctx.lineTo(p.x, p.y); ctx.stroke(); hasDrawn = true;
  });
  canvas.addEventListener('pointerup',     function() { drawing = false; });
  canvas.addEventListener('pointercancel', function() { drawing = false; });

  document.getElementById('sigClear').addEventListener('click', function() {
    var r = canvas.getBoundingClientRect();
    ctx.clearRect(0, 0, r.width, r.height);
    hasDrawn = false;
    document.getElementById('sigData').value = '';
  });

  document.getElementById('sigForm').addEventListener('submit', function() {
    if (hasDrawn) document.getElementById('sigData').value = canvas.toDataURL('image/png');
  });
})();
</script>
