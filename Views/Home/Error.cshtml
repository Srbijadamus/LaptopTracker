@{
    ViewData["Title"] = "Error";
    Layout = "_Layout";
}
<style>
.error-wrap{display:flex;justify-content:center;align-items:center;min-height:60vh;padding:40px 20px}
.error-card{background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:48px 56px;max-width:520px;width:100%;text-align:center}
.error-icon{font-size:48px;margin-bottom:20px}
.error-title{font-size:22px;font-weight:700;color:var(--text-primary);margin-bottom:6px}
.error-subtitle{font-size:15px;color:var(--text-secondary);margin-bottom:28px}
.error-id{font-size:12px;color:var(--text-muted,var(--text-secondary));margin-top:24px;word-break:break-all}
.btn-home{display:inline-block;padding:10px 28px;background:var(--accent);color:#fff;border-radius:8px;text-decoration:none;font-size:14px;font-weight:600}
.btn-home:hover{opacity:.85}
</style>
<div class="error-wrap">
  <div class="error-card">
    <div class="error-icon">&#9888;&#65039;</div>
    <div class="error-title">Something went wrong</div>
    <div class="error-subtitle">Ein Fehler ist aufgetreten</div>
    <a href="/Dashboard" class="btn-home">Back to Dashboard &nbsp;/&nbsp; Zum Dashboard</a>
    @if (!string.IsNullOrEmpty(ViewData["RequestId"]?.ToString()))
    {
      <div class="error-id">Request ID: @ViewData["RequestId"]</div>
    }
  </div>
</div>
