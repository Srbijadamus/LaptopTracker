@model List<LaptopTracker.Models.WicStockDevice>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    var searchQuery      = ViewData["SearchQuery"]      as string;
    var statusFilter     = ViewData["StatusFilter"]     as string;
    var deviceTypeFilter = ViewData["DeviceTypeFilter"] as string;
    var siteFilter       = ViewData["SiteFilter"]       as string;
    var categoryFilter   = ViewData["CategoryFilter"]   as string;
    var allDeviceTypes = ViewData["DeviceTypes"] as List<string> ?? new List<string>();
    var allSites       = ViewData["Sites"]       as List<string> ?? new List<string>();
    var allCategories  = ViewData["Categories"]  as List<string> ?? new List<string>();
    var anyFilter = !string.IsNullOrWhiteSpace(searchQuery) || !string.IsNullOrWhiteSpace(statusFilter)
        || !string.IsNullOrWhiteSpace(deviceTypeFilter)
        || !string.IsNullOrWhiteSpace(siteFilter) || !string.IsNullOrWhiteSpace(categoryFilter);
}
@section Styles {
<style>
.content{padding:0}
.search-form{display:flex;gap:10px;margin-bottom:8px}
.search-input{flex:1;padding:10px 14px;border:1px solid var(--border-input);border-radius:8px;font-size:14px;color:var(--text-primary);background:var(--bg-input);outline:none}
.search-input:focus{border-color:var(--accent)}
.search-btn{padding:10px 20px;background:var(--accent);color:#fff;border:none;border-radius:8px;font-size:14px;font-weight:700;cursor:pointer}
.panel{background:var(--bg-panel);border-radius:14px;box-shadow:0 2px 8px rgba(0,0,0,0.18);overflow:hidden}
.table-scroll{overflow-x:auto;width:100%}
table{width:100%;border-collapse:collapse}
thead th{text-align:left;padding:11px 14px;border-bottom:1px solid var(--border);background:var(--bg-thead);font-size:12px;font-weight:700;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.04em;white-space:nowrap}
thead th:first-child{width:36px;padding-left:12px;padding-right:4px}
tbody td{padding:10px 14px;border-bottom:1px solid var(--border);font-size:14px;color:var(--text-primary);vertical-align:middle}
tbody td:first-child{padding-left:12px;padding-right:4px}
tbody tr:last-child td{border-bottom:none}
tbody tr:hover{background:var(--bg-hover)}
.empty td{padding:48px;text-align:center;color:var(--text-muted);font-size:14px}
.link{color:var(--accent);font-weight:700;text-decoration:none}
.badge{display:inline-flex;align-items:center;padding:4px 10px;border-radius:999px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.04em;white-space:nowrap}
.b-reimaged{background:#3b2f6b;color:#cdbcff}
.b-expired{background:#fde0e3;color:#8a1c2b}
.b-leasesoon{background:#fff4d6;color:#755000}
.b-available{background:#dff4ff;color:#0b4a74}
.b-notavail{background:#fde2c7;color:#8a4f00}
.b-inwic{background:#f3f2f1;color:#323130}
.b-inuse{background:#fff4d6;color:#755000}
.muted{color:var(--text-muted);font-size:13px}
.scan-panel{background:var(--bg-panel);border-radius:14px;box-shadow:0 2px 8px rgba(0,0,0,0.18);padding:20px 24px;margin-bottom:16px}
.scan-panel h3{font-size:15px;font-weight:700;color:var(--text-primary);margin-bottom:14px}
.scan-row{display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end}
.scan-field{display:flex;flex-direction:column;gap:4px}
.scan-field label{font-size:12px;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.04em}
.scan-field input,.scan-field select{padding:9px 12px;border:1px solid var(--border-input);border-radius:8px;font-size:14px;color:var(--text-primary);background:var(--bg-input);outline:none;min-width:150px}
.scan-field input:focus,.scan-field select:focus{border-color:var(--accent)}
.scan-submit{padding:10px 20px;background:var(--accent);color:#fff;border:none;border-radius:8px;font-size:14px;font-weight:700;cursor:pointer;align-self:flex-end}
.filter-bar{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px;align-items:center}
.filter-select{padding:9px 13px;border:1px solid var(--border-input);border-radius:8px;font-size:14px;color:var(--text-primary);background:var(--bg-input);outline:none;cursor:pointer}
.filter-select:focus{border-color:var(--accent)}
.clear-link{padding:9px 13px;border-radius:8px;font-size:13px;font-weight:600;color:var(--text-secondary);text-decoration:none;border:1px solid var(--border-input);background:var(--bg-panel);white-space:nowrap}
.clear-link:hover{background:var(--bg-hover)}
.btn-primary{padding:10px 20px;background:var(--accent);color:#fff;border:none;border-radius:10px;font-size:14px;font-weight:700;text-decoration:none;display:inline-block;cursor:pointer}
.btn-row-del{padding:4px 10px;background:transparent;color:#c4314b;border:1px solid #c4314b;border-radius:6px;font-size:12px;font-weight:700;cursor:pointer}
.btn-row-del:hover{background:#c4314b;color:#fff}
.row-checkbox{width:16px;height:16px;cursor:pointer;accent-color:var(--accent)}
.bulk-bar{position:fixed;bottom:0;left:var(--sidebar-w,280px);right:0;background:var(--bg-topbar);border-top:1px solid var(--border);padding:14px 28px;display:none;align-items:center;gap:14px;z-index:100;box-shadow:0 -2px 12px rgba(0,0,0,0.15)}
.bulk-count{font-size:14px;font-weight:600;color:var(--text-primary);white-space:nowrap}
.bulk-edit{padding:10px 22px;background:var(--bg-panel);color:var(--accent);border:1px solid var(--accent);border-radius:8px;font-size:14px;font-weight:700;cursor:pointer;white-space:nowrap}
.row-menu{position:relative;display:inline-block}
.row-menu-btn{padding:4px 10px;background:var(--bg-input);color:var(--text-primary);border:1px solid var(--border-input);border-radius:6px;font-size:14px;font-weight:700;cursor:pointer;line-height:1}
.row-menu-btn:hover{border-color:var(--accent)}
.row-menu-list{position:absolute;right:0;top:calc(100% + 4px);min-width:170px;background:var(--bg-panel);border:1px solid var(--border);border-radius:8px;box-shadow:0 4px 14px rgba(0,0,0,0.35);padding:4px;display:none;z-index:60}
.row-menu.open .row-menu-list{display:block}
.row-menu-item{display:block;width:100%;text-align:left;padding:8px 12px;font-size:13px;color:var(--text-primary);background:transparent;border:none;border-radius:5px;text-decoration:none;cursor:pointer;white-space:nowrap}
.row-menu-item:hover{background:var(--bg-hover)}
.row-menu-item-danger{color:#c4314b}
.row-menu-item-danger:hover{background:#c4314b;color:#fff}
</style>
}

<div class="scan-panel">
  <h3>@Localizer["ScanTitle"]</h3>
  <form method="post" action="/WicStock/Scan" class="scan-row">
    <div class="scan-field">
      <label>@Localizer["ScanLabelSerial"]</label>
      <input type="text" name="serialNumber" placeholder="@Localizer["ScanPlaceholder"]" required />
    </div>
    <button type="submit" class="scan-submit">@Localizer["ScanBtn"]</button>
  </form>
</div>

<div class="content">
  <div style="display:flex;justify-content:flex-end;margin-bottom:12px">
    <a href="/WicStock/Create" class="btn-primary">@Localizer["BtnAddDevice"]</a>
  </div>

  <form method="get" action="/WicStock">
    <div class="search-form">
      <input class="search-input" name="searchQuery" type="text" placeholder="@Localizer["SearchPlaceholder"]" value="@searchQuery" />
      <button type="submit" class="search-btn">@Localizer["BtnSearch"]</button>
    </div>
    <div class="filter-bar">
      <select name="statusFilter" class="filter-select" onchange="this.form.submit()">
        <option value="">@Localizer["FilterAllStatuses"]</option>
        <option value="Available" selected="@(statusFilter == "Available" ? "selected" : null)">@StatusLocalizer.Get(LaptopTracker.Models.WicStockStatus.Available, StatusLoc)</option>
        <option value="NotAvailable" selected="@(statusFilter == "NotAvailable" ? "selected" : null)">@StatusLocalizer.Get(LaptopTracker.Models.WicStockStatus.NotAvailable, StatusLoc)</option>
      </select>
      <select name="siteFilter" class="filter-select" onchange="this.form.submit()">
        <option value="">@Localizer["FilterAllSites"]</option>
        @foreach (var site in allSites)
        {
          <option value="@site" selected="@(siteFilter == site ? "selected" : null)">@site</option>
        }
      </select>
      <select name="categoryFilter" class="filter-select" onchange="this.form.submit()">
        <option value="">@Localizer["FilterAllCategories"]</option>
        @foreach (var c in allCategories)
        {
          <option value="@c" selected="@(categoryFilter == c ? "selected" : null)">@(c == "Re-imaged laptops" ? Localizer["CatReimaged"].Value : c)</option>
        }
      </select>
      <select name="deviceTypeFilter" class="filter-select" onchange="this.form.submit()">
        <option value="">@Localizer["FilterAllTypes"]</option>
        @foreach (var t in allDeviceTypes)
        {
          <option value="@t" selected="@(deviceTypeFilter == t ? "selected" : null)">@t</option>
        }
      </select>
      @if (anyFilter)
      {
        <a href="/WicStock" class="clear-link">@Localizer["BtnClearFilters"]</a>
      }
    </div>
  </form>

  <div class="panel">
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th><input type="checkbox" id="selectAll" class="row-checkbox" title="@Localizer["ColSelectAll"]" /></th>
            <th>#</th>
            <th>@Localizer["ColSerial"]</th>
            <th>@Localizer["ColType"]</th>
            <th>RITM</th>
            <th>@Localizer["ColDate"]</th>
            <th>@Localizer["ColStatus"]</th>
            <th>@Localizer["ColSwapRITM"]</th>
            <th>@Localizer["ColCategory"]</th>
            <th>@Localizer["ColLeaseEnd"]</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          @if (!Model.Any())
          {
            <tr class="empty"><td colspan="11">@Localizer["EmptyNoDevices"]@(anyFilter ? " " + Localizer["EmptyClearFilters"].Value : "")</td></tr>
          }
          else
          {
            @for (int i = 0; i < Model.Count; i++)
            {
              var d = Model[i];
              var statusClass = d.Status == LaptopTracker.Models.WicStockStatus.Available ? "b-available" : "b-notavail";
              <tr>
                <td><input type="checkbox" value="@d.Id" class="row-check row-checkbox" /></td>
                <td class="muted">@(i + 1)</td>
                <td><a class="link" href="/WicStock/Edit/@d.Id">@d.SerialNumber</a></td>
                <td>@d.DeviceType</td>
                <td>@d.RITM</td>
                <td>@d.Date.ToString("dd/MM/yyyy")</td>
                <td><span class="badge @statusClass">@StatusLocalizer.Get(d.Status, StatusLoc)</span></td>
                <td class="muted">@(string.IsNullOrWhiteSpace(d.SwapRITM) ? "—" : d.SwapRITM)</td>
                <td>
                  @if (d.Category == "Re-imaged laptops")
                  {
                    <span class="badge b-reimaged">@Localizer["CatReimaged"]</span>
                  }
                  else
                  {
                    <span class="muted">—</span>
                  }
                </td>
                <td class="muted">
                  @(d.LeaseEndDatePlanned?.ToString("dd.MM.yyyy") ?? "—")
                  @{ var leaseState = DateTimeHelper.ClassifyLease(d.LeaseEndDatePlanned); }
                  @if (leaseState != LeaseStatus.None)
                  {
                    <span class="badge @(leaseState == LeaseStatus.Expired ? "b-expired" : "b-leasesoon")">@StatusLocalizer.GetLease(leaseState, StatusLoc)</span>
                  }
                </td>
                <td style="white-space:nowrap;text-align:right">
                  <div class="row-menu" data-menu>
                    <button type="button" class="row-menu-btn" data-menu-toggle aria-label="@Localizer["CellActions"]" title="@Localizer["CellActions"]">&#8942;</button>
                    <div class="row-menu-list">
                      <a class="row-menu-item" href="/WicStock/Edit/@d.Id">@Localizer["CellEdit"]</a>
                      <a class="row-menu-item" href="/WicStock/CreateSwap/@d.Id">@Localizer["CellSwap"]</a>
                      @if (d.Category == "Re-imaged laptops")
                      {
                        <a class="row-menu-item" href="/WicStock/GiveToUser/@d.Id">@Localizer["CellGiveToUser"]</a>
                      }
                      <button type="button" class="row-menu-item row-menu-item-danger" onclick="deleteDevice(@d.Id,'@Html.Raw(d.SerialNumber.Replace("'","\\'"  ))')">@Localizer["CellDelete"]</button>
                    </div>
                  </div>
                </td>
              </tr>
            }
          }
        </tbody>
      </table>
    </div>
  </div>

  <!-- Bulk action bar -->
  <div class="bulk-bar" id="bulkBar">
    <span class="bulk-count" id="bulkCount">0</span>
    <button type="button" class="bulk-edit" onclick="editSelected()">@Localizer["BulkEditSelected"]</button>
    <button type="button" style="padding:10px 22px;background:#1a7f37;color:#fff;border:none;border-radius:8px;font-size:14px;font-weight:700;cursor:pointer;white-space:nowrap;" onclick="handOverSelected()">@Localizer["BulkHandOver"]</button>
  </div>
</div>

@section Scripts {
<script>
var selectAll = document.getElementById('selectAll');
var bulkBar   = document.getElementById('bulkBar');
var bulkCount = document.getElementById('bulkCount');

function getChecked() { return document.querySelectorAll('.row-check:checked'); }
function getAllChecks() { return document.querySelectorAll('.row-check'); }

function updateBulkBar() {
  var n = getChecked().length;
  var total = getAllChecks().length;
  bulkBar.style.display = n > 0 ? 'flex' : 'none';
  bulkCount.textContent = n;
  selectAll.indeterminate = n > 0 && n < total;
  selectAll.checked = total > 0 && n === total;
}

selectAll.addEventListener('change', function() {
  getAllChecks().forEach(function(c) { c.checked = selectAll.checked; });
  updateBulkBar();
});

getAllChecks().forEach(function(c) { c.addEventListener('change', updateBulkBar); });

function editSelected() {
  var checks = getChecked();
  if (checks.length === 0) { alert('No devices selected.'); return; }
  var url = '/WicStock/BulkEdit?' + Array.from(checks).map(function(c) { return 'ids=' + encodeURIComponent(c.value); }).join('&');
  window.location.href = url;
}
function deleteDevice(id, serial) {
  if (!confirm('Delete ' + serial + '? This cannot be undone.')) return;
  var f = document.createElement('form');
  f.method = 'post';
  f.action = '/WicStock/Delete/' + id;
  document.body.appendChild(f);
  f.submit();
}
function handOverSelected() {
  var checks = getChecked();
  if (checks.length === 0) { alert('No devices selected.'); return; }
  var url = '/Handovers/Create?source=WicStock&' + Array.from(checks).map(function(c) { return 'ids=' + encodeURIComponent(c.value); }).join('&');
  window.location.href = url;
}

// Row action dropdown: one menu per row, closes on outside click.
document.addEventListener('click', function(e) {
  var toggle = e.target.closest('[data-menu-toggle]');
  if (toggle) {
    var menu = toggle.closest('.row-menu');
    var wasOpen = menu.classList.contains('open');
    document.querySelectorAll('.row-menu.open').forEach(function(m) { m.classList.remove('open'); });
    if (!wasOpen) menu.classList.add('open');
  } else {
    document.querySelectorAll('.row-menu.open').forEach(function(m) { m.classList.remove('open'); });
  }
});
</script>
}
