@model LaptopTracker.Models.DashboardViewModel
@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = "Dashboard";
    var ci = CultureInfo.CurrentUICulture;
    var today = DateTime.Now;
    var dateLine = today.ToString("dddd, d. MMMM yyyy", ci);
    var actionColors = new Dictionary<string,string>(StringComparer.OrdinalIgnoreCase){
        {"Create","#34D399"},{"Update","#38BDF8"},{"SoftDelete","#F87171"},
        {"HardDelete","#A78BFA"},{"Login","#67E8F9"},{"Export","#2DD4BF"},
        {"PurgeOld","#C084FC"},{"AuthCheck","#FCD34D"},{"EmailDraft","#F472B6"},
        {"Document","#94A3B8"}
    };
    // Translation lambdas for dynamic model values (controller emits German keys)
    var kindLabel = new Func<string, string>(k => k switch {
        "Rückgaben"   => Localizer["Kind_Returns"].Value,
        "WIC-Bestand" => Localizer["Kind_WicStock"].Value,
        "Leihgeräte"  => Localizer["Kind_Loaners"].Value,
        _ => k
    });
    var statusLabel = new Func<string, string>(s => s switch {
        "Ausstehend"  => Localizer["Status_Pending"].Value,
        "Abgeholt"    => Localizer["Status_Collected"].Value,
        "Übergeben"   => Localizer["Status_HandedOver"].Value,
        "Verfügbar"   => Localizer["Status_Available"].Value,
        "Nicht verf." => Localizer["Status_Unavailable"].Value,
        "In Nutzung"  => Localizer["Status_InUse"].Value,
        _ => s
    });
    var sliceLabel = new Func<string, string>(s => s switch {
        "Abholung ausstehend"  => Localizer["Slice_PendingPickup"].Value,
        "Abgeholt"             => Localizer["Slice_Collected"].Value,
        "Übergeben"            => Localizer["Slice_HandedOver"].Value,
        "WIC Verfügbar"        => Localizer["Slice_WicAvailable"].Value,
        "WIC Nicht verf."      => Localizer["Slice_WicUnavailable"].Value,
        "Leihger. Verfügbar"   => Localizer["Slice_LoanerAvailable"].Value,
        "Leihger. In Nutzung"  => Localizer["Slice_LoanerInUse"].Value,
        _ => s
    });
}
@section Styles {
<style>
/* ── Page chrome ─────────────────────────────────────────────────── */
.db-header{margin-bottom:32px}
.db-title{font-size:30px;font-weight:700;color:var(--text-primary);letter-spacing:-.02em;line-height:1.1}
.db-sub{font-size:14px;color:var(--text-muted);margin-top:4px}

/* ── KPI cards ───────────────────────────────────────────────────── */
.kpi-row{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:28px}
.kpi-card{
  background:var(--bg-card);border:1px solid var(--v2-border);border-radius:var(--radius-card);
  padding:var(--space-card);text-decoration:none;display:block;transition:border-color .15s;
}
.kpi-card:hover{border-color:var(--border-strong)}
.kpi-tile{
  width:44px;height:44px;border-radius:var(--radius-tile);
  display:flex;align-items:center;justify-content:center;font-size:20px;margin-bottom:16px;
}
.kpi-num{font-size:32px;font-weight:700;color:var(--text-primary);line-height:1;margin-bottom:6px}
.kpi-label{font-size:14px;font-weight:500;color:var(--text-primary);margin-bottom:2px}
.kpi-sub{font-size:13px;color:var(--text-muted)}

/* ── Charts row ──────────────────────────────────────────────────── */
.charts-row{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:28px}
.panel{
  background:var(--bg-card);border:1px solid var(--v2-border);
  border-radius:var(--radius-card);padding:var(--space-card);
}
.panel-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px}
.panel-title{font-size:14px;font-weight:700;color:var(--text-primary)}
.panel-link{font-size:13px;color:var(--v2-accent);text-decoration:none;font-weight:500}
.panel-link:hover{text-decoration:underline}
.panel-empty{font-size:13px;color:var(--text-muted);padding:16px 0;text-align:center}

/* Doughnut layout */
.donut-wrap{display:flex;gap:20px;align-items:center}
.donut-canvas-wrap{flex-shrink:0;width:160px;height:160px}
.donut-legend{flex:1;display:flex;flex-direction:column;gap:6px}
.legend-row{display:flex;align-items:center;gap:8px;font-size:13px}
.legend-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0}
.legend-lbl{flex:1;color:var(--text-secondary)}
.legend-cnt{font-weight:600;color:var(--text-primary);font-variant-numeric:tabular-nums}

/* ── Activity row ────────────────────────────────────────────────── */
.activity-row{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:28px}

/* Device list */
.device-row{
  display:flex;align-items:center;gap:12px;padding:10px 0;
  border-bottom:1px solid var(--v2-border);
}
.device-row:last-child{border-bottom:none}
.device-icon{
  width:36px;height:36px;border-radius:8px;display:flex;align-items:center;
  justify-content:center;font-size:16px;flex-shrink:0;
}
.device-info{flex:1;min-width:0}
.device-name{font-size:13px;font-weight:600;color:var(--text-primary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.device-meta{font-size:12px;color:var(--text-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.device-pills{display:flex;gap:6px;flex-shrink:0;flex-wrap:wrap;justify-content:flex-end}
.pill{padding:3px 9px;border-radius:var(--radius-pill);font-size:11px;font-weight:600;white-space:nowrap}

/* Audit list */
.audit-row{
  display:flex;align-items:center;gap:10px;padding:10px 0;
  border-bottom:1px solid var(--v2-border);
}
.audit-row:last-child{border-bottom:none}
.audit-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.audit-info{flex:1;min-width:0}
.audit-serial{font-size:13px;font-weight:600;color:var(--text-primary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.audit-meta{font-size:12px;color:var(--text-muted)}
.audit-time{font-size:12px;color:var(--text-muted);flex-shrink:0;font-variant-numeric:tabular-nums}

/* ── Responsive ──────────────────────────────────────────────────── */
@@media(max-width:1199px){.kpi-row{grid-template-columns:repeat(2,1fr)}}
@@media(max-width:900px){.charts-row,.activity-row{grid-template-columns:1fr}}
@@media(max-width:600px){.kpi-row{grid-template-columns:1fr}}
</style>
}

<div class="db-header">
  <div class="db-title">Dashboard</div>
  <div class="db-sub">@Localizer["PageSub"] &mdash; @dateLine</div>
</div>

<!-- ── KPI Cards ───────────────────────────────────────────────────── -->
<div class="kpi-row">
  <a href="/ReturnDevices" class="kpi-card">
    <div class="kpi-tile" style="background:var(--accent-soft)">&#x1F4E6;</div>
    <div class="kpi-num" style="color:var(--v2-accent)">@Model.ReturnCount</div>
    <div class="kpi-label">@Localizer["KpiReturnsLabel"]</div>
    <div class="kpi-sub">@Localizer["KpiReturnsSub"]</div>
  </a>
  <a href="/WicStock" class="kpi-card">
    <div class="kpi-tile" style="background:var(--purple-soft)">&#x1F5C4;&#xFE0F;</div>
    <div class="kpi-num" style="color:var(--purple)">@Model.WicStockCount</div>
    <div class="kpi-label">@Localizer["KpiWicLabel"]</div>
    <div class="kpi-sub">@Localizer["KpiWicSub"]</div>
  </a>
  <a href="/LoanerDevices" class="kpi-card">
    <div class="kpi-tile" style="background:var(--green-soft)">&#x1F4BB;</div>
    <div class="kpi-num" style="color:var(--green)">@Model.LoanerCount</div>
    <div class="kpi-label">@Localizer["KpiLoanersLabel"]</div>
    <div class="kpi-sub">@Localizer["KpiLoanersSub"]</div>
  </a>
  <a href="/ReturnDevices?status=PendingPickup" class="kpi-card">
    <div class="kpi-tile" style="background:var(--amber-soft)">&#x23F3;</div>
    <div class="kpi-num" style="color:var(--amber)">@Model.PendingCount</div>
    <div class="kpi-label">@Localizer["KpiPendingLabel"]</div>
    <div class="kpi-sub">@Localizer["KpiPendingSub"]</div>
  </a>
</div>

<!-- ── Charts Row ──────────────────────────────────────────────────── -->
<div class="charts-row">
  <!-- Doughnut: status distribution -->
  <div class="panel">
    <div class="panel-header">
      <span class="panel-title">@Localizer["ChartStatusTitle"]</span>
    </div>
    @if (Model.StatusDistribution.Any(s => s.Count > 0)) {
      <div class="donut-wrap">
        <div class="donut-canvas-wrap">
          <canvas id="donutChart"></canvas>
        </div>
        <div class="donut-legend">
          @foreach (var s in Model.StatusDistribution.Where(s => s.Count > 0)) {
            <div class="legend-row">
              <span class="legend-dot" style="background:@s.Color"></span>
              <span class="legend-lbl">@sliceLabel(s.Label)</span>
              <span class="legend-cnt">@s.Count</span>
            </div>
          }
        </div>
      </div>
    } else {
      <div class="panel-empty">@Localizer["PanelEmpty"]</div>
    }
  </div>

  <!-- Bar: devices by kind -->
  <div class="panel">
    <div class="panel-header">
      <span class="panel-title">@Localizer["ChartKindTitle"]</span>
    </div>
    @if (Model.DevicesByKind.Any(k => k.Count > 0)) {
      <canvas id="barChart" style="max-height:200px"></canvas>
    } else {
      <div class="panel-empty">@Localizer["PanelEmpty"]</div>
    }
  </div>
</div>

<!-- ── Activity Row ────────────────────────────────────────────────── -->
<div class="activity-row">
  <!-- Recent devices -->
  <div class="panel">
    <div class="panel-header">
      <span class="panel-title">@Localizer["PanelRecentDevices"]</span>
      <a href="/ReturnDevices" class="panel-link">@Localizer["PanelAllLink"] &rarr;</a>
    </div>
    @if (Model.RecentDevices.Any()) {
      @foreach (var d in Model.RecentDevices) {
        var kindColor = d.Kind == "Rückgaben" ? "var(--v2-accent)" : d.Kind == "WIC-Bestand" ? "var(--purple)" : "var(--green)";
        var kindBg    = d.Kind == "Rückgaben" ? "var(--accent-soft)" : d.Kind == "WIC-Bestand" ? "var(--purple-soft)" : "var(--green-soft)";
        var devIcon   = d.Kind == "Leihgeräte" ? "&#x1F4BB;" : d.Kind == "WIC-Bestand" ? "&#x1F5C4;&#xFE0F;" : "&#x1F4E6;";
        var listUrl   = d.Kind == "Rückgaben" ? "/ReturnDevices" : d.Kind == "WIC-Bestand" ? "/WicStock" : "/LoanerDevices";
        <a href="@listUrl" style="text-decoration:none;display:block">
          <div class="device-row">
            <div class="device-icon" style="background:@kindBg;color:@kindColor">@Html.Raw(devIcon)</div>
            <div class="device-info">
              <div class="device-name">@d.DeviceType</div>
              <div class="device-meta">@d.SerialNumber &middot; @d.RITM</div>
            </div>
            <div class="device-pills">
              <span class="pill" style="background:@kindBg;color:@kindColor">@kindLabel(d.Kind)</span>
              <span class="pill" style="background:rgba(255,255,255,0.05);color:@d.StatusColor">@statusLabel(d.StatusLabel)</span>
            </div>
          </div>
        </a>
      }
    } else {
      <div class="panel-empty">@Localizer["PanelEmpty"]</div>
    }
  </div>

  <!-- Recent audit -->
  <div class="panel">
    <div class="panel-header">
      <span class="panel-title">@Localizer["PanelRecentAudit"]</span>
      @if (Model.AuditAvailable) {
        <a href="/Audit" class="panel-link">@Localizer["PanelAuditLink"] &rarr;</a>
      }
    </div>
    @if (!Model.AuditAvailable) {
      <div class="panel-empty">@Localizer["PanelAuditUnavailable"]</div>
    } else if (!Model.RecentAudits.Any()) {
      <div class="panel-empty">@Localizer["PanelEmpty"]</div>
    } else {
      @foreach (var a in Model.RecentAudits) {
        var dotColor = actionColors.TryGetValue(a.Action, out var ac) ? ac : "#8B949E";
        var tsCet = a.TimestampUtc.ToCet();
        var isToday = tsCet.Date == DateTime.UtcNow.ToCet().Date;
        var timeStr = isToday
            ? tsCet.ToString("HH:mm")
            : tsCet.ToString("dd.MM. HH:mm");
        <div class="audit-row">
          <span class="audit-dot" style="background:@dotColor"></span>
          <div class="audit-info">
            <div class="audit-serial">@(a.EntityLabel ?? a.Action)</div>
            <div class="audit-meta">@a.Action &middot; @a.Kid</div>
          </div>
          <span class="audit-time">@timeStr</span>
        </div>
      }
    }
  </div>
</div>

@section Scripts {
@{
    // Re-declare lambdas here — @section Scripts compiles to a separate method
    var kindLabel = new Func<string, string>(k => k switch {
        "Rückgaben"   => Localizer["Kind_Returns"].Value,
        "WIC-Bestand" => Localizer["Kind_WicStock"].Value,
        "Leihgeräte"  => Localizer["Kind_Loaners"].Value,
        _ => k
    });
    var sliceLabel = new Func<string, string>(s => s switch {
        "Abholung ausstehend"  => Localizer["Slice_PendingPickup"].Value,
        "Abgeholt"             => Localizer["Slice_Collected"].Value,
        "Übergeben"            => Localizer["Slice_HandedOver"].Value,
        "WIC Verfügbar"        => Localizer["Slice_WicAvailable"].Value,
        "WIC Nicht verf."      => Localizer["Slice_WicUnavailable"].Value,
        "Leihger. Verfügbar"   => Localizer["Slice_LoanerAvailable"].Value,
        "Leihger. In Nutzung"  => Localizer["Slice_LoanerInUse"].Value,
        _ => s
    });
}
<script src="/lib/chartjs/chart.umd.min.js"></script>
<script>
(function(){
  var isDark = document.documentElement.getAttribute('data-theme') !== 'light';
  var gridColor = isDark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.08)';
  var tickColor = isDark ? '#6E7681' : '#605e5c';

  // Doughnut — labels translated server-side via sliceLabel()
  var donutEl = document.getElementById('donutChart');
  if(donutEl){
    var slices = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.StatusDistribution.Where(s => s.Count > 0)
            .Select(s => new { label = sliceLabel(s.Label), count = s.Count, color = s.Color })
            .ToList()));
    if(slices && slices.length){
      new Chart(donutEl, {
        type: 'doughnut',
        data: {
          labels: slices.map(function(s){return s.label;}),
          datasets:[{
            data: slices.map(function(s){return s.count;}),
            backgroundColor: slices.map(function(s){return s.color;}),
            borderWidth: 0,
            hoverOffset: 4
          }]
        },
        options:{
          cutout:'55%',
          plugins:{legend:{display:false},tooltip:{callbacks:{label:function(ctx){return ' '+ctx.label+': '+ctx.parsed;}}}},
          animation:{duration:400}
        }
      });
    }
  }

  // Bar — labels translated server-side via kindLabel()
  var barEl = document.getElementById('barChart');
  if(barEl){
    var kinds = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.DevicesByKind.Select(k => new { label = kindLabel(k.Kind), count = k.Count }).ToList()));
    if(kinds && kinds.length){
      new Chart(barEl, {
        type: 'bar',
        data: {
          labels: kinds.map(function(k){return k.label;}),
          datasets:[{
            data: kinds.map(function(k){return k.count;}),
            backgroundColor: ['#38BDF8','#A78BFA','#34D399'],
            borderRadius: 6,
            borderSkipped: false
          }]
        },
        options:{
          plugins:{legend:{display:false}},
          scales:{
            x:{grid:{color:gridColor},ticks:{color:tickColor}},
            y:{grid:{color:gridColor},ticks:{color:tickColor,precision:0,stepSize:1}}
          },
          animation:{duration:400}
        }
      });
    }
  }
})();
</script>
}
