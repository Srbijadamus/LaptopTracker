@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    Layout = null;
    var err    = ViewData.ModelState["kid"]?.Errors.FirstOrDefault()?.ErrorMessage;
    var curKid = ViewBag.CurrentKid as string;
    var retUrl = ViewBag.ReturnUrl as string;
}
<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@Localizer["PageTitle"]</title>
<link rel="stylesheet" href="/css/theme.css" />
<script>(function(){var t=localStorage.getItem('theme')||'dark';document.documentElement.setAttribute('data-theme',t);})();</script>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter',-apple-system,"Segoe UI",Roboto,sans-serif;background:var(--bg-page);color:var(--text-primary);display:flex;align-items:center;justify-content:center;min-height:100vh}
.card{background:var(--bg-panel);border:1px solid var(--border);border-radius:14px;padding:40px 44px;width:100%;max-width:380px}
.brand{font-size:15px;font-weight:800;color:var(--accent);margin-bottom:28px}
h1{font-size:20px;font-weight:700;color:var(--text-primary);margin-bottom:6px}
.sub{font-size:13px;color:var(--text-muted);margin-bottom:28px}
label{display:block;font-size:13px;font-weight:600;color:var(--text-secondary);margin-bottom:6px}
input[type=text]{display:block;width:100%;padding:10px 13px;background:var(--bg-input);border:1px solid var(--border-input);border-radius:8px;font-size:15px;font-weight:600;color:var(--text-primary);letter-spacing:.05em;outline:none}
input[type=text]:focus{border-color:var(--accent)}
.err{font-size:12px;color:#f87171;margin-top:6px}
button{margin-top:20px;width:100%;padding:11px;background:var(--accent);color:#fff;border:none;border-radius:8px;font-size:14px;font-weight:700;cursor:pointer}
button:hover{opacity:.9}
.switch{margin-top:18px;font-size:12px;color:var(--text-muted);text-align:center}
</style>
</head>
<body>
<div class="card">
  <div class="brand">WIC Asset Tracker</div>
  <h1>@Localizer["Heading"]</h1>
  <div class="sub">@Localizer["Subtitle"]</div>
  <form method="post" action="/Identity/Login">
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnUrl" value="@retUrl" />
    <label for="kid">KID</label>
    <input type="text" id="kid" name="kid" autocomplete="off" autofocus
           placeholder="@Localizer["Placeholder"]" style="text-transform:uppercase" />
    @if (err != null) {
      <div class="err">@err</div>
    }
    <button type="submit">@Localizer["BtnLogin"]</button>
  </form>
  @if (!string.IsNullOrEmpty(curKid)) {
    <div class="switch">@Localizer["LabelCurrent"] <strong>@curKid</strong></div>
  }
</div>
</body>
</html>
