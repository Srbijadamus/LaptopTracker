@model LaptopTracker.Models.Handover
@using Microsoft.AspNetCore.Mvc.Localization
@using LaptopTracker.Helpers
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["PageTitlePrefix"].Value + Model.Id;
    // Print change request: on paper the Work Order number is the large heading and "Übergabe #N"
    // becomes a small caption. Distinct, non-empty values of the devices (snapshot + legacy
    // fallback); null when no device has one — then the "Übergabe #N" heading stays as it is.
    var printWorkOrders = HandoverPrintHeading.WorkOrders(Model.Devices.Select(d => d.WorkOrder));
}
@section Styles {
<style>
.content{padding:0;max-width:800px}
.page-header{display:flex;align-items:center;gap:16px;margin-bottom:24px}
.page-title{font-size:22px;font-weight:800;color:var(--text-primary)}
.btn-print{padding:10px 22px;background:var(--accent);color:#fff;border:none;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer}
.btn-back{padding:10px 18px;background:transparent;color:var(--text-secondary);border:1px solid var(--border-input);border-radius:10px;font-size:14px;font-weight:600;text-decoration:none;display:inline-block}
.section{background:var(--bg-panel);border-radius:14px;box-shadow:0 2px 8px rgba(0,0,0,0.18);padding:24px;margin-bottom:20px;min-height:0}
.section-title{font-size:14px;font-weight:700;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:16px}
.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.info-item{display:flex;flex-direction:column;gap:4px}
.info-label{font-size:11px;font-weight:700;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.04em}
.info-value{font-size:15px;font-weight:600;color:var(--text-primary)}
table{width:100%;border-collapse:collapse}
thead th{text-align:left;padding:9px 12px;border-bottom:1px solid var(--border);background:var(--bg-thead);font-size:12px;font-weight:700;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.04em}
tbody td{padding:9px 12px;border-bottom:1px solid var(--border);font-size:14px;color:var(--text-primary)}
tbody tr:last-child td{border-bottom:none}
.muted{color:var(--text-muted);font-size:13px}
.sig-img{display:block;max-width:100%;border:1px solid var(--border);border-radius:8px;background:#fff}
.no-sig{color:var(--text-muted);font-style:italic;font-size:14px}
.print-heading{display:none}

@@media print {
  /* A4 at 100% scale. The margins are declared here so the print result does not depend on
     whatever page margins the browser or PDF viewer happens to have configured. */
  @@page { size: A4 portrait; margin: 12mm; }
  .v2-sidebar, .v2-hamburger, .btn-print, .btn-back, .page-header .btn-print, .page-header .btn-back { display: none !important; }
  /* .v2-main carries screen-only spacing and a 100vh min-height; both push the document
     past one printed page, so they are neutralised for print. */
  .v2-main { margin-left: 0; min-height: 0; padding: 0; }
  .content { max-width: 100%; padding: 0; }
  .section { box-shadow: none; border: 1px solid #ccc; margin-bottom: 10px; padding: 12px; min-height: 0; }
  body { background: #fff !important; color: #000 !important; }
  /* Pagination: never split a device row or the signature block, keep the table header on
     every page, and keep the signature block together with the device list above it. */
  /* Tighter rows on paper: it is what raises the number of devices that still fit one page. */
  thead th { padding: 5px 10px; }
  tbody td { padding: 5px 10px; }
  thead { display: table-header-group; }
  tfoot { display: table-footer-group; }
  tr, .info-item, .sig-img { break-inside: avoid; page-break-inside: avoid; }
  .section { break-inside: auto; page-break-inside: auto; }
  .content > .section:last-child { break-inside: avoid; page-break-inside: avoid; }
  .sig-img { max-height: 60mm; }
  /* Print change request: the Work Order is the heading of the printed document. The big value
     wraps anywhere so a long Work Order can never overflow the page; the "Übergabe #N" line in
     .page-header is demoted to a small caption that still identifies the document. */
  .print-heading { display: block; margin-bottom: 6px; }
  .print-wo-label { font-size: 11px; font-weight: 700; color: #000; text-transform: uppercase; letter-spacing: 0.05em; }
  .print-wo-value { font-size: 30px; font-weight: 800; line-height: 1.15; color: #000; overflow-wrap: anywhere; }
  .print-heading + .page-header { margin-bottom: 10px; }
  .print-heading + .page-header .page-title { font-size: 12px; font-weight: 600; color: #000; }
}
</style>
}
  <div class="content">
    @if (printWorkOrders != null)
    {
      <!-- Print only: the Work Order is the heading of the printed document. Hidden on screen,
           shown by the print CSS; the "Übergabe #N" caption below it is shrunk by the same CSS. -->
      <div class="print-heading">
        <div class="print-wo-label">@Localizer["LabelWorkOrder"]</div>
        <div class="print-wo-value">@printWorkOrders</div>
      </div>
    }
    <div class="page-header">
      <div class="page-title">@Localizer["PageTitlePrefix"]@Model.Id</div>
      <button class="btn-print" onclick="window.print()">@Localizer["BtnPrint"]</button>
      <a href="/Handovers" class="btn-back">@Localizer["BtnBack"]</a>
    </div>

    <!-- Summary -->
    <div class="section">
      <div class="section-title">@Localizer["SectionDetails"]</div>
      <div class="info-grid">
        <div class="info-item">
          <span class="info-label">@Localizer["LabelName"]</span>
          <span class="info-value">@Model.Name</span>
        </div>
        <div class="info-item">
          <span class="info-label">@Localizer["LabelKid"]</span>
          <span class="info-value">@Model.Kid</span>
        </div>
        <div class="info-item">
          <span class="info-label">@Localizer["LabelLocation"]</span>
          <span class="info-value">@Model.Location</span>
        </div>
        <div class="info-item">
          <span class="info-label">@Localizer["LabelDate"]</span>
          <span class="info-value">@Model.Date.ToString("dd/MM/yyyy HH:mm")</span>
        </div>
      </div>
    </div>

    <!-- Devices -->
    <div class="section">
      <div class="section-title">@Localizer["SectionDevices"] (@Model.Devices.Count)</div>
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>@Localizer["ColSerial"]</th>
            <th>@Localizer["ColWorkOrder"]</th>
            <th>@Localizer["ColRitm"]</th>
            <th>@Localizer["ColSource"]</th>
          </tr>
        </thead>
        <tbody>
          @if (!Model.Devices.Any())
          {
            <tr><td colspan="5" style="padding:24px;text-align:center;color:var(--text-muted)">@Localizer["EmptyNoDevices"]</td></tr>
          }
          else
          {
            @for (int i = 0; i < Model.Devices.Count; i++)
            {
              var d = Model.Devices[i];
              <tr>
                <td class="muted">@(i + 1)</td>
                <td>@d.SerialNumber</td>
                <td class="muted">@(string.IsNullOrWhiteSpace(d.WorkOrder) ? string.Empty : d.WorkOrder)</td>
                <td class="muted">@(string.IsNullOrWhiteSpace(d.Ritm) ? string.Empty : d.Ritm)</td>
                <td class="muted">@d.DeviceType</td>
              </tr>
            }
          }
        </tbody>
      </table>
    </div>

    <!-- Signature -->
    <div class="section">
      <div class="section-title">@Localizer["SectionSignature"]</div>
      @if (!string.IsNullOrWhiteSpace(Model.Signature))
      {
        <img class="sig-img" src="@Model.Signature" alt="@Localizer["AltSignature"]" />
      }
      else
      {
        <span class="no-sig">@Localizer["EmptyNoSignature"]</span>
      }
    </div>
  </div>
